# WellBoss — site de venda (Hostinger / LiteSpeed)

# Sempre HTTPS e sem "www"
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://wellboss.com.br%{REQUEST_URI} [L,R=301]

# Atalhos para o app
RewriteRule ^(entrar|login)/?$ https://app.wellboss.com.br/login [L,R=302]
RewriteRule ^(cadastro|teste|comecar)/?$ https://app.wellboss.com.br/register [L,R=302]

# Não lista pastas
Options -Indexes

# Compressão
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# Cache: HTML sempre atualizado; imagens por 30 dias
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
</IfModule>

# Segurança básica
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
